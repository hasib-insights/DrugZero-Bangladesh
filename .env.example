# ──────────────────────────────────────────────────────────────────────────
# DrugZero Bangladesh — environment configuration example
# Copy this file to ".env" (never commit the real .env) and fill in values.
# ──────────────────────────────────────────────────────────────────────────

# Public base URL of the deployed website (no trailing slash).
# Used for canonical URLs, Open Graph metadata, sitemap.xml and robots.txt.
# Production example: NEXT_PUBLIC_SITE_URL="https://www.your-domain.org"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# SQLite database location used by Prisma.
DATABASE_URL="file:./db/custom.db"
